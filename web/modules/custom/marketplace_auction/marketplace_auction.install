<?php

/**
 * @file
 * Installation and update routines for Marketplace Auction.
 */

/**
 * Add seller profile references to existing auctions.
 */
function marketplace_auction_update_11001(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();

  $definition = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('marketplace_auction')['seller_profile_id'];

  if (!$manager->getFieldStorageDefinition(
    'seller_profile_id',
    'marketplace_auction'
  )) {
    $manager->installFieldStorageDefinition(
      'seller_profile_id',
      'marketplace_auction',
      'marketplace_auction',
      $definition
    );
  }

  $database = \Drupal::database();

  $auctions = $database
    ->select('marketplace_auction', 'a')
    ->fields('a', ['id', 'seller_id'])
    ->isNull('seller_profile_id')
    ->execute();

  $linked = 0;
  $skipped = 0;

  foreach ($auctions as $auction) {
    $profiles = $database
      ->select('marketplace_seller', 's')
      ->fields('s', ['id'])
      ->condition('user_id', $auction->seller_id)
      ->range(0, 2)
      ->execute()
      ->fetchCol();

    // Do not guess if an owner has zero or multiple profiles.
    if (count($profiles) !== 1) {
      $skipped++;
      continue;
    }

    $database->update('marketplace_auction')
      ->fields([
        'seller_profile_id' => (int) $profiles[0],
      ])
      ->condition('id', $auction->id)
      ->execute();

    $linked++;
  }

  \Drupal::entityTypeManager()
    ->getStorage('marketplace_auction')
    ->resetCache();

  return "Linked $linked auctions to seller profiles; skipped $skipped.";
}


/**
 * Adds image media references to auction entities.
 */
function marketplace_auction_update_11002(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();

  if (!$manager->getFieldStorageDefinition(
    'images',
    'marketplace_auction'
  )) {
    $definition = \Drupal::service('entity_field.manager')
      ->getFieldStorageDefinitions('marketplace_auction')['images'];

    $manager->installFieldStorageDefinition(
      'images',
      'marketplace_auction',
      'marketplace_auction',
      $definition
    );
  }

  return 'Auction image references installed.';
}

/**
 * Implements hook_schema().
 */
function marketplace_auction_schema(): array {
  $schema['marketplace_proxy_bid'] = [
    'description' => 'Private maximum offers for auction proxy bidding.',
    'fields' => [
      'auction_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'bidder_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'maximum' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'sequence' => [
        'type' => 'int',
        'size' => 'big',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'changed' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['auction_id', 'bidder_id'],
    'unique keys' => [
      'auction_sequence' => ['auction_id', 'sequence'],
    ],
    'indexes' => [
      'bidder' => ['bidder_id'],
      'auction_maximum' => ['auction_id', 'maximum'],
    ],
  ];

  return $schema;
}

/**
 * Installs private proxy bidding storage.
 */
function marketplace_auction_update_11003(): string {
  $database = \Drupal::database();
  $schema = $database->schema();

  if (!$schema->tableExists('marketplace_proxy_bid')) {
    $definition = marketplace_auction_schema();
    $schema->createTable(
      'marketplace_proxy_bid',
      $definition['marketplace_proxy_bid'],
    );
  }

  return 'Private proxy bidding storage installed.';
}

/**
 * Adds bidding modes while preserving existing direct auctions.
 */
function marketplace_auction_update_11004(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();

  if (!$manager->getFieldStorageDefinition(
    'bidding_mode',
    'marketplace_auction'
  )) {
    $definition = \Drupal::service('entity_field.manager')
      ->getFieldStorageDefinitions('marketplace_auction')['bidding_mode'];

    $manager->installFieldStorageDefinition(
      'bidding_mode',
      'marketplace_auction',
      'marketplace_auction',
      $definition,
    );
  }

  $updated = \Drupal::database()
    ->update('marketplace_auction')
    ->fields(['bidding_mode' => 'direct'])
    ->isNull('bidding_mode')
    ->execute();

  \Drupal::entityTypeManager()
    ->getStorage('marketplace_auction')
    ->resetCache();

  return "Bidding modes installed; $updated existing auctions initialized.";
}
