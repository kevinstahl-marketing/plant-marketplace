<?php

/**
 * @file
 * Installation and update routines for Marketplace Auction.
 */

/**
 * Add seller profile references to existing auctions.
 */
function marketplace_auction_update_11001(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();

  $definition = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('marketplace_auction')['seller_profile_id'];

  if (!$manager->getFieldStorageDefinition(
    'seller_profile_id',
    'marketplace_auction'
  )) {
    $manager->installFieldStorageDefinition(
      'seller_profile_id',
      'marketplace_auction',
      'marketplace_auction',
      $definition
    );
  }

  $database = \Drupal::database();

  $auctions = $database
    ->select('marketplace_auction', 'a')
    ->fields('a', ['id', 'seller_id'])
    ->isNull('seller_profile_id')
    ->execute();

  $linked = 0;
  $skipped = 0;

  foreach ($auctions as $auction) {
    $profiles = $database
      ->select('marketplace_seller', 's')
      ->fields('s', ['id'])
      ->condition('user_id', $auction->seller_id)
      ->range(0, 2)
      ->execute()
      ->fetchCol();

    // Do not guess if an owner has zero or multiple profiles.
    if (count($profiles) !== 1) {
      $skipped++;
      continue;
    }

    $database->update('marketplace_auction')
      ->fields([
        'seller_profile_id' => (int) $profiles[0],
      ])
      ->condition('id', $auction->id)
      ->execute();

    $linked++;
  }

  \Drupal::entityTypeManager()
    ->getStorage('marketplace_auction')
    ->resetCache();

  return "Linked $linked auctions to seller profiles; skipped $skipped.";
}


/**
 * Adds image media references to auction entities.
 */
function marketplace_auction_update_11002(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();

  if (!$manager->getFieldStorageDefinition(
    'images',
    'marketplace_auction'
  )) {
    $definition = \Drupal::service('entity_field.manager')
      ->getFieldStorageDefinitions('marketplace_auction')['images'];

    $manager->installFieldStorageDefinition(
      'images',
      'marketplace_auction',
      'marketplace_auction',
      $definition
    );
  }

  return 'Auction image references installed.';
}

/**
 * Implements hook_schema().
 */
function marketplace_auction_schema(): array {
  $schema['marketplace_proxy_bid'] = [
    'description' => 'Private maximum offers for auction proxy bidding.',
    'fields' => [
      'auction_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'bidder_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'maximum' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'sequence' => [
        'type' => 'int',
        'size' => 'big',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'changed' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['auction_id', 'bidder_id'],
    'unique keys' => [
      'auction_sequence' => ['auction_id', 'sequence'],
    ],
    'indexes' => [
      'bidder' => ['bidder_id'],
      'auction_maximum' => ['auction_id', 'maximum'],
    ],
  ];

  return $schema;
}

/**
 * Installs private proxy bidding storage.
 */
function marketplace_auction_update_11003(): string {
  $database = \Drupal::database();
  $schema = $database->schema();

  if (!$schema->tableExists('marketplace_proxy_bid')) {
    $definition = marketplace_auction_schema();
    $schema->createTable(
      'marketplace_proxy_bid',
      $definition['marketplace_proxy_bid'],
    );
  }

  return 'Private proxy bidding storage installed.';
}

/**
 * Adds bidding modes while preserving existing direct auctions.
 */
function marketplace_auction_update_11004(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();

  if (!$manager->getFieldStorageDefinition(
    'bidding_mode',
    'marketplace_auction'
  )) {
    $definition = \Drupal::service('entity_field.manager')
      ->getFieldStorageDefinitions('marketplace_auction')['bidding_mode'];

    $manager->installFieldStorageDefinition(
      'bidding_mode',
      'marketplace_auction',
      'marketplace_auction',
      $definition,
    );
  }

  $updated = \Drupal::database()
    ->update('marketplace_auction')
    ->fields(['bidding_mode' => 'direct'])
    ->isNull('bidding_mode')
    ->execute();

  \Drupal::entityTypeManager()
    ->getStorage('marketplace_auction')
    ->resetCache();

  return "Bidding modes installed; $updated existing auctions initialized.";
}

/**
 * Installs configurable soft close fields.
 */
function marketplace_auction_update_11005(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();

  $definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('marketplace_auction');

  foreach ([
    'soft_close_window',
    'soft_close_extension',
    'original_ends_at',
    'extension_count',
  ] as $field) {
    if (!$manager->getFieldStorageDefinition(
      $field,
      'marketplace_auction',
    )) {
      $manager->installFieldStorageDefinition(
        $field,
        'marketplace_auction',
        'marketplace_auction',
        $definitions[$field],
      );
    }
  }

  $database = \Drupal::database();

  $database->update('marketplace_auction')
    ->expression('original_ends_at', 'ends_at')
    ->isNull('original_ends_at')
    ->execute();

  foreach ([
    'soft_close_window',
    'soft_close_extension',
    'extension_count',
  ] as $field) {
    $database->update('marketplace_auction')
      ->fields([$field => 0])
      ->isNull($field)
      ->execute();
  }

  \Drupal::entityTypeManager()
    ->getStorage('marketplace_auction')
    ->resetCache();

  return 'Soft close fields installed; existing deadlines preserved.';
}

/**
 * Establishes default soft close configuration.
 */
function marketplace_auction_update_11006(): string {
  $config = \Drupal::configFactory()
    ->getEditable('marketplace_auction.settings');

  foreach ([
    'default_soft_close_window' => 120,
    'default_soft_close_extension' => 120,
  ] as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }

  $config->save(TRUE);

  return 'Default soft close configuration established.';
}

/**
 * Installs auction settlement entity storage.
 */
function marketplace_auction_update_11007(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();

  if (!$manager->getEntityType('marketplace_auction_settlement')) {
    $definition = \Drupal::entityTypeManager()
      ->getDefinition('marketplace_auction_settlement');

    $manager->installEntityType($definition);
  }

  return 'Auction settlement storage installed.';
}


/**
 * Installs auction shipping specification fields.
 */
function marketplace_auction_update_11008(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();

  $definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('marketplace_auction');

  $fields = [
    'package_weight_g',
    'package_length_mm',
    'package_width_mm',
    'package_height_mm',
    'handling_days',
  ];

  foreach ($fields as $name) {
    if (!$manager->getFieldStorageDefinition($name, 'marketplace_auction')) {
      $manager->installFieldStorageDefinition(
        $name,
        'marketplace_auction',
        'marketplace_auction',
        $definitions[$name],
      );
    }
  }

  return 'Installed auction shipping specification fields.';
}
