<section class="marketplace-hero">
  <div class="container marketplace-hero__inner">

    <div class="marketplace-hero__content">

      {% if eyebrow %}
        <p class="marketplace-hero__eyebrow">
          {{ eyebrow }}
        </p>
      {% endif %}

      {% if heading %}
        <h1 class="marketplace-hero__heading">
          {{ heading }}
        </h1>
      {% endif %}

      {% if description %}
        <p class="marketplace-hero__description">
          {{ description }}
        </p>
      {% endif %}

      {% if (primary_label and primary_url) or (secondary_label and secondary_url) %}
        <div class="marketplace-hero__actions">

          {% if primary_label and primary_url %}
            {{ include('marketplace:button', {
              label: primary_label,
              url: primary_url,
              variant: 'primary'
            }, with_context = false) }}
          {% endif %}

          {% if secondary_label and secondary_url %}
            {{ include('marketplace:button', {
              label: secondary_label,
              url: secondary_url,
              variant: 'secondary'
            }, with_context = false) }}
          {% endif %}

        </div>
      {% endif %}

    </div>

    {% if image_url %}
      <div class="marketplace-hero__media">
        <img
          src="{{ image_url }}"
          alt="{{ image_alt|default('') }}"
          class="marketplace-hero__image"
          fetchpriority="high"
        >
      </div>
    {% endif %}

  </div>
</section>
