<?php

/**
 * @file
 * Seller dashboard integration hooks.
 */

use Drupal\views\ViewExecutable;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\Plugin\views\query\Sql;

/**
 * Implements hook_theme().
 */
function marketplace_seller_dashboard_theme(
  $existing,
  $type,
  $theme,
  $path
): array {
  return [
    'marketplace_seller_dashboard' => [
      'variables' => [
        'seller_name' => NULL,
        'seller_location' => NULL,
        'statistics' => [],
        'create_link' => NULL,
        'auctions' => NULL,
      ],
      'template' => 'marketplace-seller-dashboard',
    ],
  ];
}

/**
 * Implements hook_views_query_alter().
 */
function marketplace_seller_dashboard_views_query_alter(
  ViewExecutable $view,
  QueryPluginBase $query
): void {
  if ($view->id() !== 'seller_auctions' || !$query instanceof Sql) {
    return;
  }

  $account = \Drupal::currentUser();

  $seller = \Drupal::service('marketplace_seller.manager')
    ->getActiveSellerForUser((int) $account->id());

  $table = $query->ensureTable('marketplace_auction');

  // Group zero is reserved for mandatory contextual conditions.
  if (!$seller || !$account->hasPermission('create marketplace auctions')) {
    $query->addWhereExpression(0, '1 = 0');
    return;
  }

  $query->addWhere(
    0,
    "$table.seller_id",
    (int) $account->id(),
    '='
  );

  $query->addWhere(
    0,
    "$table.seller_profile_id",
    (int) $seller->id(),
    '='
  );
}
