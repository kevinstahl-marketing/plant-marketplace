<?php

/**
 * Prepares catalog data for the product card view mode.
 */
function marketplace_preprocess_node__shopify_product__product_card(array &$variables): void {
  $product = $variables['node'];

  $provider = \Drupal::service('marketplace_catalog.variant_provider');
  $summary = $provider->getSummary($product);

  $variables['product_price'] = $summary['price'];
  $variables['product_available'] = $summary['available'];

  foreach ($summary['variants'] as $variant) {
    $variables['#cache']['tags'] = array_merge(
      $variables['#cache']['tags'] ?? [],
      $variant->getCacheTags()
    );
  }

  $variables['#cache']['tags'][] = 'node_list:shopify_variant';
}

/**
 * Prepares the Shopify product's full content display.
 */
function marketplace_preprocess_node__shopify_product__full(array &$variables): void {
  $product = $variables['node'];

  $description = $product->get('field_description')->value ?? '';

  $variables['product_description'] = [
    '#markup' => \Drupal\Component\Utility\Xss::filter(
      $description,
      [
        'p', 'br', 'strong', 'em', 'b', 'i',
        'ul', 'ol', 'li', 'a', 'h2', 'h3',
        'h4', 'blockquote',
      ]
    ),
  ];
}
