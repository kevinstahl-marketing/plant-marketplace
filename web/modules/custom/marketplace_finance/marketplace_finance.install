<?php

/**
 * @file
 * Marketplace Finance installation and updates.
 */

/**
 * Installs seller commission overrides and auction snapshots.
 */
function marketplace_finance_update_11001(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();

  foreach ([
    'marketplace_seller',
    'marketplace_auction',
  ] as $type) {

    $entity_type = \Drupal::entityTypeManager()
      ->getDefinition($type);

    $fields = marketplace_finance_entity_base_field_info(
      $entity_type
    );

    foreach ($fields as $name => $definition) {
      if (!$manager->getFieldStorageDefinition($name, $type)) {
        $manager->installFieldStorageDefinition(
          $name,
          $type,
          'marketplace_finance',
          $definition,
        );
      }
    }
  }

  return 'Installed commission policy fields.';
}

/**
 * Backfills commission terms for existing development auctions.
 */
function marketplace_finance_update_11002(): string {
  $database = \Drupal::database();

  $count = $database->update('marketplace_auction')
    ->fields([
      'commission_snapshot_bps' => 1000,
      'commission_snapshot_source' => 'legacy_backfill',
      'commission_locked_at' => \Drupal::time()->getCurrentTime(),
    ])
    ->isNull('commission_snapshot_bps')
    ->condition('status', [
      'open',
      'scheduled',
      'closed',
    ], 'IN')
    ->execute();

  \Drupal::entityTypeManager()
    ->getStorage('marketplace_auction')
    ->resetCache();

  return sprintf(
    'Backfilled commission terms for %d legacy auctions.',
    $count,
  );
}

/**
 * Implements hook_schema().
 */
function marketplace_finance_schema(): array {
  $schema['marketplace_finance_transaction'] = [
    'description' => 'Immutable marketplace sale agreements.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'settlement_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'auction_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'order_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'seller_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'buyer_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'currency' => [
        'type' => 'varchar',
        'length' => 3,
        'not null' => TRUE,
      ],
      'merchandise_amount' => [
        'type' => 'int',
        'size' => 'big',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'commission_bps' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'commission_amount' => [
        'type' => 'int',
        'size' => 'big',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'seller_proceeds' => [
        'type' => 'int',
        'size' => 'big',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'commission_source' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'created' => [
        'type' => 'int',
        'size' => 'big',
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'settlement' => ['settlement_id'],
      'order' => ['order_id'],
      'auction' => ['auction_id'],
    ],
    'indexes' => [
      'seller' => ['seller_id'],
      'buyer' => ['buyer_id'],
      'created' => ['created'],
    ],
  ];

  return $schema;
}

/**
 * Creates persistent marketplace financial transaction storage.
 */
function marketplace_finance_update_11003(): string {
  $schema = \Drupal::database()->schema();

  if (!$schema->tableExists('marketplace_finance_transaction')) {
    $definitions = marketplace_finance_schema();

    $schema->createTable(
      'marketplace_finance_transaction',
      $definitions['marketplace_finance_transaction'],
    );
  }

  return 'Created marketplace financial transaction storage.';
}
