<section class="category-carousel" aria-label="{{ heading|default('Browse categories') }}">
  <div class="container">

    <div class="category-carousel__header">
      <div class="category-carousel__intro">
        {% if eyebrow %}
          <p class="category-carousel__eyebrow">{{ eyebrow }}</p>
        {% endif %}

        <h2 class="category-carousel__heading">
          {{ heading|default('Explore the Marketplace') }}
        </h2>

        {% if description %}
          <p class="category-carousel__description">{{ description }}</p>
        {% endif %}
      </div>

      <div class="category-carousel__controls">
        <button type="button" class="category-carousel__button" data-carousel-prev aria-label="Scroll categories left">
          ←
        </button>
        <button type="button" class="category-carousel__button" data-carousel-next aria-label="Scroll categories right">
          →
        </button>
      </div>
    </div>

    <div class="category-carousel__track" data-carousel-track tabindex="0" aria-label="Categories">
      {{ cards }}
    </div>

  </div>
</section>
