<article class="product-card">
  <a class="product-card__link" href="{{ url|default('#') }}">
    <div class="product-card__media">
      {% if image_url %}
        <img
          class="product-card__image"
          src="{{ image_url }}"
          alt="{{ title }}"
          loading="lazy"
        >
      {% endif %}
    </div>

    <div class="product-card__content">
      {% if category %}
        <span class="product-card__category">
          {{ category }}
        </span>
      {% endif %}

      <h3 class="product-card__title">
        {{ title }}
      </h3>

      {{ include('marketplace:product-price', {
        price: price,
        available: available,
        size: 'medium'
      }, with_context = false) }}
    </div>
  </a>
</article>
